#!/usr/bin/env python3
"""A BlueZ pairing agent that asks the shell.

Quickshell can pair a device but cannot export a D-Bus object, and bluez asks an
agent to confirm every pairing -- even a mouse's, which has no code to show -- so
without one every pairing is refused. This registers as the default agent and turns
each question bluez asks into one JSON line on stdout; the shell answers on stdin.

Out, one object per line:
  {"type": "authorize", "device": <path>}                 yes or no
  {"type": "confirm",   "device": <path>, "code": "..."}  yes or no
  {"type": "display",   "device": <path>, "code": "...", "entered": n or null}
  {"type": "passkey",   "device": <path>}                 answer <number>
  {"type": "pincode",   "device": <path>}                 answer <text>
  {"type": "service",   "device": <path>, "uuid": "..."}  yes or no
  {"type": "cancel"}
  {"type": "ready"}

In, one word per line: `yes`, `no`, or `answer <value>`, always for whatever was
asked last. `display` is not a question -- bluez is told at once -- and is repeated
as each key is typed on the device, which is what `entered` counts.

It lives as long as the shell's pipe does: stdin closing is the shell going away.
"""

import json
import os
import select
import sys

from jeepney import DBusAddress, HeaderFields, MatchRule, MessageType
from jeepney import new_error, new_method_call, new_method_return
from jeepney.bus_messages import message_bus
from jeepney.io.blocking import open_dbus_connection

PATH = "/fi/kuori/btagent"
AGENT = "org.bluez.Agent1"
# a laptop has both, and anything less leaves some device unpairable: a keyboard
# needs a display to show the code it wants typed, a phone needs yes and no.
CAPABILITY = "KeyboardDisplay"

MANAGER = DBusAddress("/org/bluez", bus_name="org.bluez", interface="org.bluez.AgentManager1")

REJECTED = "org.bluez.Error.Rejected"
CANCELED = "org.bluez.Error.Canceled"


def emit(**event):
    sys.stdout.write(json.dumps(event) + "\n")
    sys.stdout.flush()


def log(text):
    print(f"kuori-btagent: {text}", file=sys.stderr, flush=True)


def register(conn):
    # the order matters: RequestDefaultAgent names an agent already registered.
    # it has to be the default rather than merely registered, because bluez hands a
    # pairing to the agent owned by whoever called Pair -- that is quickshell's own
    # connection, not this one -- and falls back to the default when there is none.
    for method, signature, body in [
        ("RegisterAgent", "os", (PATH, CAPABILITY)),
        ("RequestDefaultAgent", "o", (PATH,)),
    ]:
        reply = conn.send_and_get_reply(new_method_call(MANAGER, method, signature, body), timeout=5)
        if reply.header.message_type == MessageType.error:
            raise RuntimeError(f"{method}: {reply.header.fields.get(HeaderFields.error_name)} {reply.body}")

    emit(type="ready")


class Agent:
    def __init__(self, conn):
        self.conn = conn
        # the one call bluez is waiting on, and what its answer must look like.
        # bluez only ever has one pairing in flight, and asks again rather than
        # queueing, so a newer question retires the older one.
        self.waiting = None
        self.reply = None

    def ask(self, msg, reply, **event):
        self.drop(CANCELED)
        self.waiting = msg
        self.reply = reply
        emit(**event)

    def drop(self, error):
        if self.waiting is not None:
            self.conn.send(new_error(self.waiting, error))
        self.waiting = None
        self.reply = None

    def call(self, msg):
        member = msg.header.fields.get(HeaderFields.member)
        body = msg.body

        if member == "Release":
            # bluez letting go of us, usually because it is shutting down. the owner
            # watch below re-registers when it comes back.
            self.drop(CANCELED)
            self.conn.send(new_method_return(msg))
        elif member == "Cancel":
            self.waiting = None
            self.reply = None
            self.conn.send(new_method_return(msg))
            emit(type="cancel")
        elif member == "RequestAuthorization":
            self.ask(msg, "", type="authorize", device=body[0])
        elif member == "RequestConfirmation":
            self.ask(msg, "", type="confirm", device=body[0], code=f"{body[1]:06d}")
        elif member == "AuthorizeService":
            self.ask(msg, "", type="service", device=body[0], uuid=body[1])
        elif member == "RequestPasskey":
            self.ask(msg, "u", type="passkey", device=body[0])
        elif member == "RequestPinCode":
            self.ask(msg, "s", type="pincode", device=body[0])
        elif member == "DisplayPasskey":
            self.conn.send(new_method_return(msg))
            emit(type="display", device=body[0], code=f"{body[1]:06d}", entered=body[2])
        elif member == "DisplayPinCode":
            # a legacy keyboard's pin, generated by bluez. nothing reports keys typed.
            self.conn.send(new_method_return(msg))
            emit(type="display", device=body[0], code=body[1], entered=None)
        else:
            self.conn.send(new_error(msg, "org.freedesktop.DBus.Error.UnknownMethod"))

    def answer(self, line):
        if self.waiting is None:
            return

        word, _, value = line.partition(" ")

        if word == "yes" and self.reply == "":
            self.conn.send(new_method_return(self.waiting))
        elif word == "answer" and self.reply == "u" and value.isdigit() and int(value) <= 999999:
            self.conn.send(new_method_return(self.waiting, "u", (int(value),)))
        elif word == "answer" and self.reply == "s" and 1 <= len(value) <= 16:
            self.conn.send(new_method_return(self.waiting, "s", (value,)))
        else:
            self.conn.send(new_error(self.waiting, REJECTED))

        self.waiting = None
        self.reply = None


def main():
    conn = open_dbus_connection(bus="SYSTEM")

    # a registration dies with bluetoothd, silently: the process looks healthy and
    # every pairing fails with "no agent available". watching the name is how this
    # finds out, and a new owner is registered with again.
    rule = MatchRule(
        type="signal",
        sender="org.freedesktop.DBus",
        interface="org.freedesktop.DBus",
        member="NameOwnerChanged",
        path="/org/freedesktop/DBus",
    )
    rule.add_arg_condition(0, "org.bluez")
    conn.send_and_get_reply(message_bus.AddMatch(rule), timeout=5)

    register(conn)
    agent = Agent(conn)
    pending = b""

    while True:
        readable, _, _ = select.select([conn.sock, sys.stdin.fileno()], [], [])

        if sys.stdin.fileno() in readable:
            chunk = os.read(sys.stdin.fileno(), 4096)
            if not chunk:
                agent.drop(CANCELED)
                return

            pending += chunk
            *lines, pending = pending.split(b"\n")
            for line in lines:
                agent.answer(line.decode(errors="replace").strip())

        if conn.sock in readable:
            # one read can carry several messages, and select only knows about the
            # socket, not jeepney's buffer -- so drain until it has nothing left.
            while True:
                try:
                    msg = conn.receive(timeout=0)
                except TimeoutError:
                    break

                kind = msg.header.message_type

                if kind == MessageType.method_call and msg.header.fields.get(HeaderFields.path) == PATH:
                    agent.call(msg)
                elif kind == MessageType.method_call:
                    conn.send(new_error(msg, "org.freedesktop.DBus.Error.UnknownObject"))
                elif kind == MessageType.signal and msg.header.fields.get(HeaderFields.member) == "NameOwnerChanged":
                    _, _, owner = msg.body
                    agent.drop(CANCELED)
                    if owner:
                        log("bluetoothd came back; registering again")
                        register(conn)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
