#!/usr/bin/env python3
"""Sync Google Calendar events into one file the shell reads.

    kuori-calendar auth <account> [client.json]   consent once, per google account
    kuori-calendar sync                           what the timer runs

Standard library only. Credentials live in the state directory, never in a repo;
the result lands in the cache directory, where services/Calendar.qml watches it.
"""

import json
import os
import secrets
import sys
import urllib.error
import urllib.parse
import urllib.request
from datetime import date, datetime, timedelta
from http.server import BaseHTTPRequestHandler, HTTPServer

SCOPE = "https://www.googleapis.com/auth/calendar.readonly"
AUTH_URL = "https://accounts.google.com/o/oauth2/v2/auth"
TOKEN_URL = "https://oauth2.googleapis.com/token"
API = "https://www.googleapis.com/calendar/v3"

# how far the panel can page and still find dots. the month before this one, in
# case the tab is opened on the 1st looking back, and three ahead.
MONTHS_BACK = 1
MONTHS_AHEAD = 3


def log(msg):
    print(msg, file=sys.stderr, flush=True)


def xdg_dir(unit_var, xdg_var, fallback):
    # systemd hands a unit StateDirectory / CacheDirectory as absolute paths in
    # these variables; from a terminal the xdg names apply, then the defaults.
    if os.environ.get(unit_var):
        return os.environ[unit_var]
    base = os.environ.get(xdg_var) or os.path.expanduser(fallback)
    return os.path.join(base, "kuori")


STATE_DIR = xdg_dir("STATE_DIRECTORY", "XDG_STATE_HOME", "~/.local/state")
CACHE_DIR = xdg_dir("CACHE_DIRECTORY", "XDG_CACHE_HOME", "~/.cache")
CREDENTIALS = os.path.join(STATE_DIR, "google-oauth.json")
OUTPUT = os.path.join(CACHE_DIR, "calendar.json")


def load_credentials():
    try:
        with open(CREDENTIALS) as f:
            return json.load(f)
    except FileNotFoundError:
        return {"accounts": {}}


def save_credentials(creds):
    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
    tmp = CREDENTIALS + ".tmp"
    with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
        json.dump(creds, f, indent=2)
    os.replace(tmp, CREDENTIALS)


def post_form(url, fields):
    data = urllib.parse.urlencode(fields).encode()
    req = urllib.request.Request(url, data=data, method="POST")
    with urllib.request.urlopen(req, timeout=30) as resp:
        return json.load(resp)


def get_json(url, token, params):
    full = f"{url}?{urllib.parse.urlencode(params)}"
    req = urllib.request.Request(full, headers={"Authorization": f"Bearer {token}"})
    with urllib.request.urlopen(req, timeout=30) as resp:
        return json.load(resp)


# -- auth ---------------------------------------------------------------------


class CodeCatcher(BaseHTTPRequestHandler):
    code = None
    state = None

    def do_GET(self):
        query = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
        ok = query.get("state", [None])[0] == CodeCatcher.state and "code" in query
        if ok:
            CodeCatcher.code = query["code"][0]
        self.send_response(200)
        self.send_header("Content-Type", "text/plain; charset=utf-8")
        self.end_headers()
        self.wfile.write(
            b"kuori: signed in, you can close this tab." if ok
            else b"kuori: that did not work, check the terminal.")

    def log_message(self, *args):
        pass


def read_client(path):
    with open(path) as f:
        blob = json.load(f)
    # the console's download wraps a desktop client in "installed"
    inner = blob.get("installed") or blob.get("web") or blob
    return inner["client_id"], inner["client_secret"]


def auth(account, client_path=None):
    creds = load_credentials()
    entry = creds["accounts"].get(account, {})

    if client_path:
        entry["client_id"], entry["client_secret"] = read_client(client_path)
    elif "client_id" not in entry:
        entry["client_id"] = input("client id: ").strip()
        entry["client_secret"] = input("client secret: ").strip()

    # google only issues a refresh token to a request that asks for offline access
    # and forces the consent screen; a repeat consent without prompt=consent comes
    # back with an access token alone.
    server = HTTPServer(("127.0.0.1", 0), CodeCatcher)
    redirect = f"http://127.0.0.1:{server.server_port}"
    CodeCatcher.state = secrets.token_urlsafe(16)
    url = AUTH_URL + "?" + urllib.parse.urlencode({
        "client_id": entry["client_id"],
        "redirect_uri": redirect,
        "response_type": "code",
        "scope": SCOPE,
        "access_type": "offline",
        "prompt": "consent",
        "state": CodeCatcher.state,
    })

    log(f"sign in as the '{account}' google account at:\n\n  {url}\n")
    try:
        import subprocess
        subprocess.Popen(["xdg-open", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass

    while CodeCatcher.code is None:
        server.handle_request()
    server.server_close()

    tokens = post_form(TOKEN_URL, {
        "code": CodeCatcher.code,
        "client_id": entry["client_id"],
        "client_secret": entry["client_secret"],
        "redirect_uri": redirect,
        "grant_type": "authorization_code",
    })
    if "refresh_token" not in tokens:
        log(f"no refresh token in google's answer: {tokens}")
        return 1

    entry["refresh_token"] = tokens["refresh_token"]
    creds["accounts"][account] = entry
    save_credentials(creds)
    log(f"saved a refresh token for '{account}' in {CREDENTIALS}")
    return 0


# -- sync ---------------------------------------------------------------------


def access_token(entry):
    answer = post_form(TOKEN_URL, {
        "client_id": entry["client_id"],
        "client_secret": entry["client_secret"],
        "refresh_token": entry["refresh_token"],
        "grant_type": "refresh_token",
    })
    return answer["access_token"]


def paged(url, token, params):
    while True:
        page = get_json(url, token, params)
        yield from page.get("items", [])
        if not page.get("nextPageToken"):
            return
        params = dict(params, pageToken=page["nextPageToken"])


def declined(event):
    for who in event.get("attendees", []):
        if who.get("self") and who.get("responseStatus") == "declined":
            return True
    return False


def month_start(day, offset):
    y, m = divmod(day.month - 1 + offset, 12)
    return date(day.year + y, m + 1, 1)


def sort_key(event):
    # all-day events carry a bare date; put them at midnight so a day's list
    # opens with them, ahead of anything timed.
    value = event["start"]
    if event["allDay"]:
        return datetime.fromisoformat(value).astimezone()
    return datetime.fromisoformat(value)


def fetch_account(name, entry, time_min, time_max):
    token = access_token(entry)
    calendars = []
    events = []

    for cal in paged(f"{API}/users/me/calendarList", token, {"minAccessRole": "reader"}):
        if not cal.get("selected"):
            continue
        # the primary calendar is named after the account's email address, which
        # is not a legend entry anyone wants; the name the account was given
        # here -- "personal", "work" -- is.
        calendars.append({
            "id": cal["id"],
            "account": name,
            "name": name.capitalize() if cal.get("primary")
                else cal.get("summaryOverride") or cal.get("summary", cal["id"]),
            "color": cal.get("backgroundColor", "#5aa2ff"),
        })
        params = {
            "singleEvents": "true",
            "orderBy": "startTime",
            "timeMin": time_min,
            "timeMax": time_max,
            "maxResults": "2500",
        }
        for ev in paged(f"{API}/calendars/{urllib.parse.quote(cal['id'], safe='')}/events", token, params):
            if ev.get("status") == "cancelled":
                continue
            # working-location entries are google's "in the office" markers, one
            # per weekday, and would put a dot on every day of the month.
            if ev.get("eventType") == "workingLocation":
                continue
            if declined(ev):
                continue
            all_day = "date" in ev["start"]
            events.append({
                "id": ev["id"],
                "calendar": cal["id"],
                "title": ev.get("summary", "(No title)"),
                "start": ev["start"]["date"] if all_day else ev["start"]["dateTime"],
                "end": ev["end"]["date"] if all_day else ev["end"]["dateTime"],
                "allDay": all_day,
                "location": ev.get("location", ""),
            })

    return calendars, events


def sync():
    creds = load_credentials()
    accounts = creds.get("accounts", {})
    if not accounts:
        log(f"no accounts in {CREDENTIALS}; run `kuori-calendar auth <name>` first")
        return 1

    now = datetime.now().astimezone()
    today = now.date()
    first = month_start(today, -MONTHS_BACK)
    after = month_start(today, MONTHS_AHEAD + 1)
    tz = now.tzinfo
    time_min = datetime.combine(first, datetime.min.time(), tz).isoformat()
    time_max = datetime.combine(after, datetime.min.time(), tz).isoformat()

    calendars = {}
    events = {}
    failed = 0

    for name, entry in accounts.items():
        try:
            cals, evs = fetch_account(name, entry, time_min, time_max)
        except urllib.error.HTTPError as e:
            body = e.read().decode(errors="replace")
            log(f"{name}: {e.code} {e.reason}: {body[:300]}")
            failed += 1
            continue
        except (urllib.error.URLError, OSError, KeyError, ValueError) as e:
            log(f"{name}: {e}")
            failed += 1
            continue

        # a calendar shared into both accounts arrives twice; the first account
        # to name it keeps it, and its events with it.
        for cal in cals:
            calendars.setdefault(cal["id"], cal)
        for ev in evs:
            events.setdefault((ev["calendar"], ev["id"]), ev)

    if failed == len(accounts):
        log("every account failed; keeping the previous file")
        return 1

    out = {
        "fetched": now.isoformat(timespec="seconds"),
        "from": first.isoformat(),
        "to": (after - timedelta(days=1)).isoformat(),
        "calendars": list(calendars.values()),
        "events": sorted(events.values(), key=sort_key),
    }

    os.makedirs(CACHE_DIR, exist_ok=True)
    tmp = OUTPUT + ".tmp"
    with open(tmp, "w") as f:
        json.dump(out, f, ensure_ascii=False)
    os.replace(tmp, OUTPUT)

    log(f"{len(out['events'])} events from {len(out['calendars'])} calendars -> {OUTPUT}"
        + (f" ({failed} account(s) failed)" if failed else ""))
    return 0


def main(argv):
    if len(argv) >= 2 and argv[0] == "auth":
        return auth(argv[1], argv[2] if len(argv) > 2 else None)
    if argv == ["sync"]:
        return sync()
    log(__doc__.strip())
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
